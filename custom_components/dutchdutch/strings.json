{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "description": "Enter the IP address or hostname of a Dutch & Dutch speaker.",
        "data": {
          "host": "[%key:common::config_flow::data::host%]"
        }
      },
      "zeroconf_confirm": {
        "title": "Add Dutch & Dutch room",
        "description": "Do you want to add the room {name} ({host}) to Home Assistant?"
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]"
    }
  },
  "entity": {
    "select": {
      "xlr_mode": {
        "name": "XLR mode",
        "state": {
          "aes": "AES digital",
          "analogLowGain": "Analog (low gain)",
          "analogHighGain": "Analog (high gain)"
        }
      },
      "preset": {
        "name": "Preset"
      }
    },
    "switch": {
      "linear_phase": {
        "name": "Linear phase"
      }
    }
  }
}
